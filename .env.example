# Application
APP_ENV=development
PORT=8080

# Database (matches docker-compose postgres service)
DATABASE_URL=postgres://karea:karea_secret@localhost:5432/karea?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Browser CORS allowlist (comma-separated exact origins — no wildcards).
# Include every Vite port you may land on locally (5173 is default; 5174+ when
# an older instance still holds the previous port).
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# Comma-separated company domains allowed when creating users (case-insensitive).
# Leave empty to skip the restriction (local development). Seed users use
# karea.local — set this in production so only company addresses can be added.
ALLOWED_EMAIL_DOMAINS=karea.local

# Web (optional overrides). Vite loads this file from the repository root
# (see web/vite.config.ts envDir) and exposes VITE_API_BASE_URL to api.ts.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Mobile (optional overrides) — use LAN IP on a physical device, not localhost.
# Loaded by mobile/babel.config.js from this file (Expo does not use envDir).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
